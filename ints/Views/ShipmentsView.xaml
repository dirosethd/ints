<UserControl x:Class="ints.Views.ShipmentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ints.Views"
        mc:Ignorable="d"
         Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Новая перевозка топлива" Margin="0,0,0,10">
            <WrapPanel Margin="8">
                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <DatePicker Margin="8,0" SelectedDate="{Binding NewDate}"/>

                <TextBlock Text="Авто:" VerticalAlignment="Center"/>
                <ComboBox Width="140" Margin="8,0"
                          ItemsSource="{Binding Cars}"
                          SelectedItem="{Binding SelectedCar}"
                          DisplayMemberPath="RegNumber"/>

                <TextBlock Text="Водитель:" VerticalAlignment="Center"/>
                <ComboBox Width="220" Margin="8,0"
                          ItemsSource="{Binding DriversFiltered}"
                          SelectedItem="{Binding SelectedDriver}"
                          DisplayMemberPath="FullName"/>

                <TextBlock Text="Топливо:" VerticalAlignment="Center"/>
                <ComboBox Width="140" Margin="8,0"
                          ItemsSource="{Binding FuelTypes}"
                          SelectedItem="{Binding SelectedFuelType}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Откуда:" VerticalAlignment="Center"/>
                <TextBox Width="170" Margin="8,0"
                         Text="{Binding NewFrom, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Куда:" VerticalAlignment="Center"/>
                <TextBox Width="170" Margin="8,0"
                         Text="{Binding NewTo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Км:" VerticalAlignment="Center"/>
                <TextBox Width="80" Margin="8,0"
                         Text="{Binding NewDistanceKm, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Литры:" VerticalAlignment="Center"/>
                <TextBox Width="80" Margin="8,0"
                         Text="{Binding NewVolumeLiters, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Добавить" Command="{Binding AddCommand}" Margin="12,0,0,0"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
                <Button Content="Удалить выбранную" Command="{Binding DeleteSelectedCommand}"/>
            </WrapPanel>
        </GroupBox>

        <TextBlock Grid.Row="1" Foreground="DarkRed" Margin="2,0,0,10"
                   Text="{Binding Error}" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Shipments}"
                  SelectedItem="{Binding SelectedShipment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Авто" Binding="{Binding Car.RegNumber}" Width="110"/>
                <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="*"/>
                <DataGridTextColumn Header="Топливо" Binding="{Binding FuelType.Name}" Width="120"/>
                <DataGridTextColumn Header="Откуда" Binding="{Binding FromLocation}" Width="140"/>
                <DataGridTextColumn Header="Куда"   Binding="{Binding ToLocation}"   Width="140"/>
                <DataGridTextColumn Header="Км" Binding="{Binding DistanceKm}" Width="80"/>
                <DataGridTextColumn Header="Литры" Binding="{Binding VolumeLiters}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
