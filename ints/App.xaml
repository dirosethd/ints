<Application x:Class="ints.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ints"
             xmlns:vm="clr-namespace:ints.ViewModels"
             xmlns:v="clr-namespace:ints.Views">
             
    <Application.Resources>
        <!-- (опционально) стили -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:CarsViewModel}">
            <v:CarsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <v:DriversView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FuelTypesViewModel}">
            <v:FuelTypesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ShipmentsViewModel}">
            <v:ShipmentsView/>
        </DataTemplate>
        
        

    </Application.Resources>
</Application>
